[user]
	name = Diego Alves
	email = odiegoasilva@gmail.com
	signingKey = ~/.ssh/id_ed25519.pub
[core]
	editor = hx
[push]
	default = current
	autoSetupRemote = true
	followTags = true
[commit]
	gpgSign = true
	verbose = true
[gpg]
	format = ssh
[url "git@github.com:"]
	insteadOf = https://github.com/
[branch]
	sort = -committerdate
[diff]
	algorithm = histogram
	colorMoved = plain
	colorMovedWS = allow-indentation-change
[merge]
	conflictStyle = zdiff3
[status]
	showUntrackedFiles = all
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[pull]
	rebase = true
[fetch]
	prune = true
[init]
	defaultBranch = main
[rerere]
	enabled = true
