{{- $variant := .chezmoi.osRelease.variantId }}

{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

# Flatpak applications
echo "Installing Flatpak applications"
flatpak remote-add --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo

echo "Common applications"
{{ range .packages.flatpak.common -}}
flatpak install -y flathub {{ . }}
{{ end -}}

{{ if .personal -}}
echo "Home applications"
{{ range .packages.flatpak.home -}}
flatpak install -y flathub {{ . }}
{{ end -}}
{{ else -}}
echo "Work applications"
{{ range .packages.flatpak.work -}}
flatpak install -y flathub {{ . }}
{{ end -}}
{{ end -}}

echo "Flatpak applications installed successfully"

# Ghostty
echo "Installing Ghostty"
{{ if eq $variant "workstation" -}}
sudo dnf copr enable --assumeyes scottames/ghostty
sudo dnf install --assumeyes ghostty

{{ else if eq $variant "silverblue" -}}
. /etc/os-release
curl -fsSL \
    "https://copr.fedorainfracloud.org/coprs/scottames/ghostty/repo/fedora-${VERSION_ID}/scottames-ghostty-fedora-${VERSION_ID}.repo" \
    | sudo tee /etc/yum.repos.d/_copr:copr.fedorainfracloud.org:scottames:ghostty.repo > /dev/null
rpm-ostree refresh-md
rpm-ostree install ghostty
{{ end -}}

echo "Ghostty installed successfully"

# Mise
echo "Installing Mise"
if ! command -v mise >/dev/null 2>&1; then
    curl https://mise.run | sh
fi

mise bootstrap --yes
echo "Dotfiles installed successfully"

{{ end -}}
